# Copy this file's contents into Vercel → Project → Settings → Environment Variables.
# Never commit an actual .env file with real values to GitHub.

# From Neon dashboard → Connect → connection string (with password shown)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# The password you'll type to log into /admin. Pick something you don't use
# anywhere else.
ADMIN_PASSWORD=choose-a-strong-password-here

# A random secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Paste the output here — you never need to remember it.
AUTH_SECRET=replace-with-a-long-random-string
